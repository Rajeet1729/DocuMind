<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>io.github.agentic</groupId>
	<artifactId>documind</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<spring-ai.version>2.0.1</spring-ai.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-elasticsearch</artifactId>
		</dependency>
		<!-- Boot's Elasticsearch client module. Provides the Rest5Client bean the Spring
		     AI vector-store autoconfig consumes, plus ElasticsearchConnectionDetails for
		     docker-compose (runtime) and the Testcontainers @ServiceConnection factory
		     (tests). Not pulled transitively by the Spring AI ES starter under Boot 4.x. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-elasticsearch</artifactId>
		</dependency>
		<!-- Page-aware PDF reading (PagePdfDocumentReader). Version managed by the
		     Spring AI BOM; transitively brings Apache PDFBox. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-pdf-document-reader</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-elasticsearch</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Token counting for the eval harness's *estimated* cost summary. jtokkit is a
		     pure-Java BPE tokenizer with the OpenAI encodings (o200k_base covers the
		     gpt-4o/gpt-5/gpt-6 family); used only to estimate embedding and generation
		     token counts, which carry no usage metadata back to the harness. Judge calls
		     report their real usage from the API, so those are not estimated. Test-only. -->
		<dependency>
			<groupId>com.knuddels</groupId>
			<artifactId>jtokkit</artifactId>
			<version>1.1.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<profiles>
		<!-- Run the paid eval harness on demand: `./mvnw test -Peval`. Clears the default
		     eval exclusion and runs ONLY eval-tagged tests. -->
		<profile>
			<id>eval</id>
			<!-- Judge model for the faithfulness harness. Default is the self-judge; swap
			     to a cross-model judge on the command line, no code edit:
			     `./mvnw test -Peval -Ddocumind.eval.judge-model=gpt-6-sol`. -->
			<properties>
				<documind.eval.judge-model>gpt-6-luna</documind.eval.judge-model>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludedGroups combine.self="override"></excludedGroups>
							<groups>eval</groups>
							<!-- Harness classes are *Evaluation, not *Test, so the default
							     build never even considers them; include them here. -->
							<includes>
								<include>**/eval/*Evaluation.java</include>
							</includes>
							<!-- Mirror production ingestion: the app runs without -ea, but
							     Surefire enables it by default, which trips PDFBox's internal
							     asserts on some real PDFs. The harness ingests exactly as prod
							     does, so assertions are off here. -->
							<enableAssertions>false</enableAssertions>
							<!-- Surefire forks a JVM; forward the judge-model property so the
							     @Value in the harness picks up the command-line override. -->
							<systemPropertyVariables>
								<documind.eval.judge-model>${documind.eval.judge-model}</documind.eval.judge-model>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- The eval harness (@Tag("eval")) makes real, paid OpenAI calls, so it must
			     NEVER run in the normal build. Exclude the tag by default; run it on demand
			     with the `eval` profile (`./mvnw test -Peval`), which clears the exclusion
			     and includes only that tag. A plain -Dgroups=eval would NOT work: an
			     excludedGroups set here always wins over an included group. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>eval</excludedGroups>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
